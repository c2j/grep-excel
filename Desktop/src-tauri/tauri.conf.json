{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "grep-excel Desktop",
    "version": "0.3.3"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.grep-excel.desktop",
      "publisher": "c2j",
      "copyright": "Copyright © 2024-2026 c2j. All rights reserved.",
      "category": "DeveloperTool",
      "shortDescription": "Desktop GUI for grep-excel",
      "longDescription": "Graphical frontend for grep-excel: search and query tabular files (Excel/CSV and more) with the shared grep-excel-core engine.",
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ]
    },
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "dialog": {
        "all": false,
        "open": true
      }
    },
    "windows": [
      {
        "title": "grep-excel",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "url": "index.html",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "distDir": "../dist"
  }
}
